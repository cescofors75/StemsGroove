{
  "name": "sterms-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "node scripts/dev-solo.cjs",
    "dev:raw": "next dev",
    "dev:clean": "npm run clean && next dev",
    "dev:solo": "node scripts/dev-solo.cjs",
    "build": "next build",
    "start": "next start",
    "serve": "npm run build && npm run start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "15.5.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
